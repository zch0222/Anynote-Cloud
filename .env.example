# 复制为 .env 后按需修改，本文件只提供本地开发默认值。
COMPOSE_PROJECT_NAME=anynote

# 镜像版本
MYSQL_VERSION=8.0.42
REDIS_VERSION=6.2-alpine
NACOS_VERSION=v2.4.3
ELASTICSEARCH_VERSION=8.7.0
ROCKETMQ_VERSION=5.3.0
MINIO_VERSION=latest
XXL_JOB_ADMIN_VERSION=2.5.0
CURL_VERSION=8.10.1

# 中间件端口
MYSQL_PORT=3306
REDIS_PORT=6379
NACOS_HTTP_PORT=8848
NACOS_GRPC_PORT=9848
NACOS_RAFT_PORT=9849
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_TRANSPORT_PORT=9300
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_FAST_PORT=10909
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_HA_PORT=10912
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
XXL_JOB_PORT=10086

# 应用端口
GATEWAY_PORT=8080
AUTH_PORT=8083
ADMIN_PORT=8079
SYSTEM_PORT=8091
NOTE_PORT=18091
FILE_PORT=8095
AI_PORT=9210
AI_NIO_PORT=9065
MANAGE_PORT=18092
NOTIFY_PORT=9066
JOB_PORT=8093
EXTERNAL_API_PORT=8097

# 数据库与账号
MYSQL_ROOT_PASSWORD=AnynoteRoot123
MYSQL_APP_USER=anynote
MYSQL_APP_PASSWORD=Anynote*1832
MYSQL_DATABASE=anynote
NACOS_DB_NAME=anynote_config
XXL_JOB_DB_NAME=anynote_xxl_job

# Redis 密码可留空；如果设置，Compose 会自动启用 requirepass。
REDIS_PASSWORD=

# Nacos 配置
NACOS_NAMESPACE=0587fa28-1301-43db-a7a1-599c00fc3f70
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# MinIO 配置
MINIO_ROOT_USER=anynote
MINIO_ROOT_PASSWORD=AnynoteMinio123
MINIO_BUCKET=anynote

# RocketMQ 配置
# 宿主机端口绑定地址：仅本机访问写 127.0.0.1，需对外暴露写 0.0.0.0
ROCKETMQ_BROKER_BIND_IP=127.0.0.1
# broker 上报给客户端的地址（brokerIP1）
#  - 仅 docker 网内的微服务消费：写 docker service 名 rocketmq-broker
#  - 需要宿主机/外部客户端消费：写宿主机可达的 IP（注意此时容器内也要能解析到该 IP）
ROCKETMQ_BROKER_ADVERTISE_IP=rocketmq-broker

# 应用运行参数
SPRING_PROFILES_ACTIVE=dev
JAVA_OPTS=-Xms256m -Xmx512m
AI_FASTAPI_ADDRESS=http://host.docker.internal:8000
