{
  "settings": {
    "analysis": {
      "analyzer": {
        "my_analyzer": {
          "tokenizer": "ik_max_word",
          "filter": "py"
        }
      },
      "filter": {
        "py": {
          "type": "pinyin",
          "keep_full_pinyin": false,
          "keep_joined_full_pinyin": true,
          "keep_original": true,
          "limit_first_letter_length": 16,
          "remove_duplicated_term": true,
          "none_chinese_pinyin_tokenize": false
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": {
        "type": "keyword"
      },
      "title": {
        "type": "text",
        "analyzer": "my_analyzer",
        "search_analyzer": "ik_max_word",
        "copy_to": ["all", "titleSuggest"]
      },
      "knowledgeBaseId": {
        "type": "long"
      },
      "permissions": {
        "type": "integer"
      },
      "deleted": {
        "type": "integer"
      },
      "createBy": {
        "type": "long"
      },
      "createTime": {
        "type": "date"
      },
      "updateBy":{
        "type": "long"
      },
      "updateTime": {
        "type": "date"
      },
      "all": {
        "type": "text",
        "search_analyzer": "ik_max_word",
        "analyzer": "my_analyzer"
      },
      "titleSuggest": {
        "type": "completion",
        "analyzer": "my_analyzer",
        "search_analyzer": "ik_max_word"
      }
    }
  }
}